{
  "manifest_version": 3,
  "name": "Save to TabShelf",
  "version": "1.0.0",
  "description": "Save the current page to your Mac menu bar shelf with one click.",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Save this page to TabShelf",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
